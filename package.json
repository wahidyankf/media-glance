{
  "name": "media-glance",
  "version": "0.1.0",
  "private": true,
  "description": "media-glance.nvim development tooling",
  "type": "module",
  "license": "MIT",
  "volta": {
    "node": "24.16.0",
    "npm": "11.11.0"
  },
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "setup": "node scripts/cli.mjs setup",
    "vendor": "node scripts/cli.mjs vendor",
    "build": "node scripts/cli.mjs build",
    "check:unit": "node scripts/cli.mjs unit",
    "check:fast": "node scripts/cli.mjs fast",
    "check:integration": "node scripts/cli.mjs integration",
    "check:complete": "node scripts/cli.mjs complete",
    "test:js": "c8 --all --include=web/*.js --include=scripts/*.mjs --exclude=web/vendor/** --reports-dir=.coverage/js --reporter=json-summary --reporter=text node --test --test-concurrency=2 test/unit/*.test.mjs",
    "test:browser": "node scripts/cli.mjs browser",
    "release:build": "node scripts/cli.mjs release",
    "tools": "node scripts/cli.mjs tools",
    "browser:install": "node scripts/cli.mjs browser-install"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "c8": "12.0.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "katex": "0.18.3",
    "mermaid": "11.16.1",
    "prettier": "3.6.2"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.18.3"
    }
  }
}
